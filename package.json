{
  "name": "trivgoo-travel-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vite build",
    "postbuild:disabled": "react-snap",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "include": [
      "/",
      "/about-us",
      "/contact",
      "/help-center"
    ],
    "exclude": [
      "/dashboard",
      "/checkout",
      "/login",
      "/register",
      "/my-account",
      "/my-bookings"
    ],
    "inlineCss": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/geist": "^5.2.8",
    "@google/genai": "^1.30.0",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "firebase": "^12.11.0",
    "framer-motion": "^12.34.4",
    "hashids": "^2.3.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.10.9",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "knex": "^3.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^16.6.6",
    "react-leaflet": "^4.2.1",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.22.3",
    "recharts": "2.12.7",
    "sweetalert2": "^11.26.18"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-datepicker": "^6.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react-snap": "^1.23.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
